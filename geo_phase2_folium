='CartoDB dark_matter'  # tema gelap, lebih clean\n",")\n","\n","# Tambahkan titik gempa satu per satu\n","for _, row in indonesia.iterrows():\n","\n","    # Tentukan warna berdasarkan magnitudo\n","    if row['mag'] >= 6.0:\n","        warna = 'red'\n","    elif row['mag'] >= 5.0:\n","        warna = 'orange'\n","    else:\n","        warna = 'yellow'\n","\n","    # Tambahkan circle ke peta\n","    folium.CircleMarker(\n","        location=[row['latitude'], row['longitude']],\n","        radius=row['mag'] * 2,        # ukuran lingkaran\n","        color=warna,\n","        fill=True,\n","        fill_opacity=0.7,\n","        popup=folium.Popup(\n","            f\"\"\"\n","            <b>{row['place']}</b><br>\n","            Magnitudo: {row['mag']}<br>\n","            Kedalaman: {row['depth']} km<br>\n","            Waktu: {row['time'][:19]}\n","            \"\"\",\n","            max_width=250\n","        ),\n","        tooltip=f\"M{row['mag']} - {row['place']}\"\n","    ).add_to(peta)\n","\n","# Simpan sebagai HTML\n","peta.save('gempa_indonesia.html')\n","print(\"Peta berhasil dibuat!\")\n","\n","# Tampilkan langsung di Colab\n","peta\n","\n","# Tambahkan legend manual ke peta\n","legend_html = \"\"\"\n","<div style=\"position: fixed; bottom: 30px; left: 30px; z-index: 1000;\n","     background: rgba(0,0,0,0.8); padding: 12px 16px; border-radius: 8px;\n","     color: white; font-family: Arial; font-size: 12px;\">\n","    <b>Magnitudo Gempa</b><br><br>\n","    <span style=\"color:red\">●</span> &ge; 6.0 (Kuat)<br>\n","    <span style=\"color:orange\">●</span> 5.0 &ndash; 5.9 (Sedang)<br>\n","    <span style=\"color:yellow\">●</span> &lt; 5.0 (Ringan)<br><br>\n","    <i>Sumber: USGS Real-time Feed</i>\n","</div>\n","\"\"\"\n","\n","peta.get_root().html.add_child(folium.Element(legend_html))\n","peta.save('gempa_indonesia.html')\n","peta"]}]}