{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPTQG/OXL5p5WGT+gCovuHs"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# Generate citra sintetis 200x200 pixel\n","# Simulasi area dengan vegetasi, tanah, dan air\n","np.random.seed(42)\n","height, width = 200, 200\n","\n","# Buat channel R, G, B\n","R = np.zeros((height, width))\n","G = np.zeros((height, width))\n","B = np.zeros((height, width))\n","\n","# Area vegetasi lebat (hijau tua) - kiri atas\n","R[0:80, 0:80] = np.random.randint(30, 60, (80, 80))\n","G[0:80, 0:80] = np.random.randint(100, 160, (80, 80))\n","B[0:80, 0:80] = np.random.randint(20, 50, (80, 80))\n","\n","# Area vegetasi tipis (hijau muda) - kanan atas\n","R[0:80, 80:160] = np.random.randint(80, 120, (80, 80))\n","G[0:80, 80:160] = np.random.randint(130, 180, (80, 80))\n","B[0:80, 80:160] = np.random.randint(60, 90, (80, 80))\n","\n","# Area tanah/lahan kering - tengah\n","R[80:140, 0:200] = np.random.randint(150, 200, (60, 200))\n","G[80:140, 0:200] = np.random.randint(120, 160, (60, 200))\n","B[80:140, 0:200] = np.random.randint(80, 120, (60, 200))\n","\n","# Area air/sungai - bawah kiri\n","R[140:200, 0:100] = np.random.randint(20, 50, (60, 100))\n","G[140:200, 0:100] = np.random.randint(40, 80, (60, 100))\n","B[140:200, 0:100] = np.random.randint(100, 160, (60, 100))\n","\n","# Area urban/bangunan - bawah kanan\n","R[140:200, 100:200] = np.random.randint(150, 220, (60, 100))\n","G[140:200, 100:200] = np.random.randint(140, 200, (60, 100))\n","B[140:200, 100:200] = np.random.randint(130, 190, (60, 100))\n","\n","# Gabungkan jadi citra RGB\n","img_array = np.stack([R, G, B], axis=2).astype(np.uint8)\n","\n","plt.figure(figsize=(6, 6))\n","plt.imshow(img_array)\n","plt.title(\"Citra Simulasi Area Campuran\")\n","plt.axis('off')\n","\n","# Label area\n","plt.text(40, 40, 'Vegetasi\\nLebat', color='white', ha='center', fontsize=8, weight='bold')\n","plt.text(120, 40, 'Vegetasi\\nTipis', color='white', ha='center', fontsize=8, weight='bold')\n","plt.text(100, 110, 'Tanah Kering', color='white', ha='center', fontsize=8, weight='bold')\n","plt.text(50, 170, 'Air', color='white', ha='center', fontsize=8, weight='bold')\n","plt.text(150, 170, 'Urban', color='white', ha='center', fontsize=8, weight='bold')\n","\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"Shape:\", img_array.shape)\n","print(\"Citra berhasil dibuat dengan 5 jenis area berbeda\")\n","\n","# Pisahkan channel R dan G\n","# Catatan: kita pakai G sebagai proxy NIR karena tidak punya sensor infrared\n","# Di dunia nyata, NIR dari sensor khusus drone/satelit (band ke-4)\n","R = img_array[:, :, 0].astype(float)\n","G = img_array[:, :, 1].astype(float)\n","B = img_array[:, :, 2].astype(float)\n","\n","# Hitung Pseudo-NDVI (pakai G sebagai proxy NIR)\n","# Rumus: (NIR - Red) / (NIR + Red)\n","epsilon = 1e-10  # hindari pembagian dengan 0\n","ndvi = (G - R) / (G + R + epsilon)\n","\n","print(\"NDVI range:\", ndvi.min().round(3), \"sampai\", ndvi.max().round(3))\n","print(\"\\nRata-rata NDVI per area:\")\n","print(\"Vegetasi Lebat :\", ndvi[0:80, 0:80].mean().round(3))\n","print(\"Vegetasi Tipis :\", ndvi[0:80, 80:160].mean().round(3))\n","print(\"Tanah Kering   :\", ndvi[80:140, 0:200].mean().round(3))\n","print(\"Air            :\", ndvi[140:200, 0:100].mean().round(3))\n","print(\"Urban          :\", ndvi[140:200, 100:200].mean().round(3))\n","\n","# Visualisasi NDVI\n","fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n","\n","# Citra asli\n","axes[0].imshow(img_array)\n","axes[0].set_title(\"Citra RGB Asli\")\n","axes[0].axis('off')\n","\n","# NDVI heatmap\n","ndvi_plot = axes[1].imshow(ndvi, cmap='RdYlGn', vmin=-1, vmax=1)\n","axes[1].set_title(\"Hasil Analisis NDVI\")\n","axes[1].axis('off')\n","plt.colorbar(ndvi_plot, ax=axes[1], label='NDVI Value\\n(-1=Air/Urban, +1=Vegetasi)')\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# Interpretasi otomatis per pixel\n","interpretasi = np.select(\n","    condlist=[\n","        ndvi > 0.4,\n","        (ndvi > 0.1) & (ndvi <= 0.4),\n","        (ndvi > -0.1) & (ndvi <= 0.1),\n","        ndvi <= -0.1\n","    ],\n","    choicelist=['Vegetasi Lebat', 'Vegetasi Sedang', 'Tanah/Urban', 'Air/Tidak Produktif'],\n","    default='Unknown'\n",")\n","\n","# Hitung persentase tiap kategori\n","unique, counts = np.unique(interpretasi, return_counts=True)\n","total = interpretasi.size\n","\n","print(\"=== LAPORAN ANALISIS LAHAN ===\")\n","for kategori, jumlah in zip(unique, counts):\n","    persen = (jumlah / total * 100).round(1)\n","    print(f\"{kategori:<25}: {persen}%\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"RgK-Zz6L_r51","executionInfo":{"status":"ok","timestamp":1781696771265,"user_tz":-420,"elapsed":2309,"user":{"displayName":"ano ji","userId":"14063743097888691962"}},"outputId":"1b647bfa-a9ae-428b-946c-99e2c1c11c74"},"execution_count":1,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 600x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Shape: (200, 200, 3)\n","Citra berhasil dibuat dengan 5 jenis area berbeda\n","NDVI range: -0.248 sampai 0.683\n","\n","Rata-rata NDVI per area:\n","Vegetasi Lebat : 0.486\n","Vegetasi Tipis : 0.218\n","Tanah Kering   : -0.111\n","Air            : 0.266\n","Urban          : -0.041\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x500 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["=== LAPORAN ANALISIS LAHAN ===\n","Air/Tidak Produktif      : 20.8%\n","Tanah/Urban              : 34.9%\n","Vegetasi Lebat           : 16.0%\n","Vegetasi Sedang          : 28.3%\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"Urt5O7dUAxcm"},"execution_count":nu